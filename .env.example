# Database
DATABASE_URL=postgresql://modelops:modelops@localhost:5432/modelops

# MLflow
MLFLOW_TRACKING_URI=sqlite:///data/mlflow.db
MLFLOW_EXPERIMENT_NAME=modelops-lab

# Model serving
MODEL_STAGE=production
MODEL_NAME=fraud-classifier
MODEL_ARTIFACT_PATH=data/artifacts/models
INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8000

# API
API_HOST=0.0.0.0
API_PORT=8080
MAX_REQUEST_SIZE_BYTES=1048576
MAX_BATCH_SIZE=1000

# Monitoring
PROMETHEUS_PORT=9464
OTEL_SERVICE_NAME=modelops-inference
DRIFT_PSI_THRESHOLD=0.2
DRIFT_KS_THRESHOLD=0.05

# Security
SECRET_KEY=change-me-in-production
ALLOWED_ORIGINS=http://localhost:3000

# Redis (optional queue)
REDIS_URL=redis://localhost:6379/0

# Reproducibility
RANDOM_SEED=42
