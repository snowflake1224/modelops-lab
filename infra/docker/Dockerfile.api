FROM python:3.12-slim

WORKDIR /app

RUN pip install uv

COPY pyproject.toml .
RUN uv pip install --system -e ".[dev]" || pip install -e .

COPY packages/ packages/
COPY apps/ apps/
COPY configs/ configs/

ENV PYTHONPATH=/app
EXPOSE 8080

CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8080"]
